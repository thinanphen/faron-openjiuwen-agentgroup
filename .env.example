# 法元 Agent Group —— 模型接口配置示例
#
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 排除，不会入库）
#     然后在 shell 中导出这些变量，或由你的运行环境注入。
#
# 注意：openjiuwen 的模型配置是通过 ModelClientConfig 显式传入的，
#      本仓库在 faron_agentgroup/config.py 的 load_config_from_env() 中读取以下变量。

# OpenAI 兼容接口地址（含 /v1）
FARON_LLM_API_BASE=https://api.deepseek.com/v1

# 接口密钥（切勿提交到仓库）
FARON_LLM_API_KEY=sk-your-key-here

# 客户端 provider 标识，OpenAI 兼容一律填 openai
FARON_LLM_PROVIDER=openai

# 强模型：分配给「主理」与「起草员」（推理与生成质量最关键）
FARON_LLM_MODEL_STRONG=deepseek-chat

# 轻量模型：分配给「检索员」「图谱策展」「质检员」（主要是工具调用与格式遵循）
FARON_LLM_MODEL_FAST=deepseek-chat

# 工作区根目录（团队成员的相对路径基准）
FARON_WORKSPACE=./runtime

# 团队存储后端：sqlite / postgresql / mysql / memory
FARON_STORAGE=sqlite
