+  return {
+    kind: "candidate",
+    value: {
+      decision,
+      manifest,
+      realSamples: anon.kept.reduce((s, p) => s + p.real_samples, 0),
+      tasksConsidered: rows.length,
+      droppedBuckets: anon.dropped.length,
+    },
+  };
